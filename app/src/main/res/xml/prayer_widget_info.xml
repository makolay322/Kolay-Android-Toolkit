<?xml version="1.0" encoding="utf-8"?>
<!-- Placed at 3 x 2, resizable from 1 x 1 up to 5 x 5; the layout for each size is chosen in PrayerWidget (size buckets).
     Appearance (background, transparency, text colour) is set in PrayerWidgetConfig: optional when placing, long-press to reopen (Android 12+). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp" android:minHeight="110dp" android:minResizeWidth="40dp" android:minResizeHeight="40dp"
    android:maxResizeWidth="560dp" android:maxResizeHeight="680dp"
    android:targetCellWidth="3" android:targetCellHeight="2"
    android:updatePeriodMillis="1800000" android:resizeMode="horizontal|vertical"
    android:initialLayout="@layout/widget_prayer_full" android:widgetCategory="home_screen"
    android:configure="app.kolay.shell.PrayerWidgetConfig" android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_prayer_desc"/>
