<?xml version="1.0" encoding="utf-8"?>
<!-- 2 x 2 and larger: the next prayer on top (name + remaining time, its time), below it all six times of that day in a 3 x 2 grid.
     Text auto-sizes up to large maxima, so it grows with the widget; the padding grows too (PrayerWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1"
            android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical" android:paddingBottom="6dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"
                    android:maxLines="1" android:gravity="start|bottom" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp"/>
                <Chronometer android:id="@+id/left" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="start|top" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <TextView android:id="@+id/time" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2"
                android:maxLines="1" android:gravity="end|center_vertical" android:fontFamily="sans-serif-light" android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="88sp" android:autoSizeStepGranularity="1sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/n0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/t0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                    android:maxLines="1" android:gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/n1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                    android:maxLines="1" android:gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/n2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/t2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                    android:maxLines="1" android:gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/n3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/t3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                    android:maxLines="1" android:gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/n4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/t4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                    android:maxLines="1" android:gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/n5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                    android:maxLines="1" android:gravity="center" android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/t5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                    android:maxLines="1" android:gravity="center" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="34sp" android:autoSizeStepGranularity="1sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
