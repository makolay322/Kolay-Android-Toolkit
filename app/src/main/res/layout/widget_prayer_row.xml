<?xml version="1.0" encoding="utf-8"?>
<!-- Wide and short (from about 4 x 1): the six times of the day in one row, the next one highlighted in code.
     From about 5 x 1 the "lead" block (next prayer + countdown) is shown in front (PrayerWidget sets its visibility). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <LinearLayout android:id="@+id/lead" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6"
            android:orientation="vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"
                android:gravity="start|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp"/>
            <Chronometer android:id="@+id/left" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="start|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:id="@+id/n0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp"/>
            <TextView android:id="@+id/t0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                android:gravity="center|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:id="@+id/n1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp"/>
            <TextView android:id="@+id/t1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                android:gravity="center|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:id="@+id/n2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp"/>
            <TextView android:id="@+id/t2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                android:gravity="center|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:id="@+id/n3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp"/>
            <TextView android:id="@+id/t3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                android:gravity="center|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:id="@+id/n4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp"/>
            <TextView android:id="@+id/t4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                android:gravity="center|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="3dp" android:paddingEnd="3dp">
            <TextView android:id="@+id/n5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center|bottom" android:fontFamily="sans-serif-medium" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp"/>
            <TextView android:id="@+id/t5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3"
                android:gravity="center|top" android:fontFeatureSettings="tnum" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeStepGranularity="1sp"
                android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="22sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
